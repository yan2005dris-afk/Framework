# Configuracion del servicio SaaS.
# Convencion: prefijo SAAS_ para secrets y nombres sensibles; resto sin prefijo.
# Para correr local: cp .env.example .env y editar lo necesario.

APP_ENV=dev
CORS_ORIGINS=http://localhost:5173

SAAS_DB_HOST=localhost
SAAS_DB_PORT=5435
SAAS_DB_USER=postgres
SAAS_DB_PASSWORD=postgres
SAAS_DB_NAME=multicatalogo_saas
