# Caddyfile del API Gateway.
#
# Contrato de rutas (el mismo que ya usan el frontend y el Backend):
#   /api/*        -> Backend Go/Fiber (B2C)   :3000
#   /api/saas/*   -> SaaS FastAPI             :8000
#   /health       -> health del propio gateway (sin auth)
#   /             -> frontend estatico (SPA compilado en la imagen del gateway)
#
# El Backend monta su grupo de rutas en /api (Backend/routes/routes.go:
# `api := app.Group("/api")`), asi que el path se reenvia SIN reescribir.
# Antes el gateway proxeaba /api/tx/* y el Backend nunca vio esas rutas:
# /api/tx/red llegaba al Backend como /api/tx/red, que no existe -> 404.
# El frontend (VITE_API_URL=http://localhost:8080/api) tampoco coincidia.
#
# Auth centralizada:
#   Los endpoints de API se validan via forward_auth al auth-service (:3001),
#   que devuelve 200 + headers X-User-Id / X-User-Email / X-User-Rol /
#   X-Tenant-Id / X-Rol-Saas si el token es valido (cookie auth_token o
#   header Authorization: Bearer). Esos headers se copian al upstream.
#
#   EXCEPCIONES (sin forward_auth, si no el login es imposible: pediria un
#   token para poder emitir el token):
#     - /api/login, /api/logout            (Backend)
#     - /api/productos, /api/productos/*   (catalogo publico del Backend)
#     - /api/saas/auth/*                   (proxy del SaaS al auth-service)
#     - /api/saas/webhooks/stripe          (Stripe no manda cookie; valida HMAC)
#     - /api/health, /api/saas/health      (healthchecks)
#
#   `/api/saas/plans` NO es excepcion: el catalogo no es tenant-scoped, pero
#   si exige identidad (S10 + tests de billing esperan 401 sin token).
#
# TLS (#20). La direccion del sitio sale del entorno, no del archivo, para no
# tener dos Caddyfiles que se separan con el tiempo:
#
#   - Sin SITE_ADDRESS (desarrollo, el default): `http://localhost:8080`, HTTP
#     plano. Es exactamente el comportamiento previo a U4.
#   - Con SITE_ADDRESS=api.tudominio.com y ACME_EMAIL=vos@tudominio.com:
#     Caddy pide el certificado a Let's Encrypt por HTTP-01 (puerto 80) y lo
#     renueva solo. Pasar a produccion es cambiar dos variables del `.env`,
#     no editar este archivo.
#
# OJO: la variable no puede quedar DEFINIDA VACIA. Si SITE_ADDRESS existe pero
# esta vacio, el placeholder no resuelve, el bloque se interpreta como site
# global y Caddy ni arranca ("unrecognized global option"). Para no publicar
# TLS, la linea se comenta en el `.env`; nunca se deja en blanco.
{$SITE_ADDRESS:http://localhost:8080} {

    # TLS (#20). Hay un solo interruptor, ACME_EMAIL, y tres modos:
    #
    #   - Sin SITE_ADDRESS (desarrollo): `http://localhost:8080`. auto_https se
    #     apaga solo por la direccion http, asi que esta linea no hace nada.
    #   - Con SITE_ADDRESS=https://localhost:8443 y sin ACME_EMAIL: el default
    #     `internal` emite un certificado de la CA interna de Caddy. Es el TLS
    #     local de S7: no depende de un dominio publico, y el browser avisa que
    #     no confia en la CA (se acepta una vez por maquina).
    #   - Con SITE_ADDRESS=api.tudominio.com y ACME_EMAIL=vos@tudominio.com:
    #     Let's Encrypt por HTTP-01, con renovacion automatica.
    #
    # AVISO: `internal` es el default y por eso mismo es un modo de
    # DESARROLLO. Un deploy real con el dominio puesto y ACME_EMAIL olvidado
    # emite un certificado que ningun browser confia: no es un error visible,
    # es un sitio que no abre. Si publicas, ACME_EMAIL va en el `.env`.
    tls {$ACME_EMAIL:internal}

    # Todo va dentro de un unico `route` a proposito. Caddy ordena las
    # directivas por tipo (no por el orden en que se escriben), asi que un
    # `forward_auth` suelto corre ANTES de cualquier `handle`, y las rutas
    # publicas quedarian detras de auth igual. `route` preserva el orden
    # literal de escritura, que es justo lo que hace falta aca: primero el
    # health, despues el auth, despues el proxying.
    route {

        # --- Rate limiting (#21) ------------------------------------------------
        # Va primero: un request bloqueado no deberia llegar ni al auth-service
        # ni al upstream.
        #
        # Dos zonas con proposito distinto:
        #   - login: frena fuerza bruta de credenciales. Es el endpoint mas
        #     caro (bcrypt) y el mas atacable.
        #   - api:   techo general de abuso sobre /api/*.
        #
        # La clave es {remote_host} (IP del cliente, sin confiar en
        # X-Forwarded-For, que el cliente puede falsificar).
        #
        # Solo se limita /api/*: el health del gateway y los assets del SPA
        # quedan fuera, para que un 429 de la API no rompa la carga de la app.
        @login_limited {
            path /api/login
        }
        rate_limit @login_limited {
            zone login {
                key {remote_host}
                events 10
                window 1m
            }
        }

        @api_limited {
            path /api/*
        }
        rate_limit @api_limited {
            zone api {
                key {remote_host}
                events 300
                window 1m
            }
        }

        # --- Health del propio gateway ------------------------------------------
        # Sin auth, para el HEALTHCHECK del Dockerfile. Responde 200 mientras
        # Caddy este vivo; no toca los upstreams (para eso estan sus healthchecks).
        @gateway_health path /health
        respond @gateway_health "ok" 200

        # --- Auth central -------------------------------------------------------
        # El matcher excluye las rutas publicas. Sin las exclusiones, el login
        # devuelve 401 porque forward_auth exige un token para emitir el token.
        @protected {
            path /api/*
            not path /api/login
            not path /api/logout
            not path /api/health
            not path /api/productos
            not path /api/productos/*
            not path /api/saas/health
            not path /api/saas/webhooks/stripe
            not path /api/saas/auth/*
        }

        forward_auth @protected auth-service:3001 {
            uri /auth/validate
            # GET, y no POST, a proposito. Caddy construye el subrequest de
            # forward_auth con los headers del request original, incluido su
            # Content-Length; con POST eso consume el body original y el
            # reverse_proxy que viene despues se queda sin cuerpo. El sintoma
            # era un 502 "http: ContentLength=N with Body length 0" en TODOS
            # los POST autenticados con body (el checkout entre ellos), y no se
            # veía desde el gateway: el backend directo respondia 201.
            #
            # /auth/validate no lee el body (solo mira el token), asi que un
            # GET pierde nada y deja el body intacto para el upstream.
            method GET
            copy_headers X-User-Id X-User-Email X-User-Rol X-Tenant-Id X-Rol-Saas
            # Caddy propaga Authorization + Cookie por defecto, asi que el
            # auth-service recibe el token del cliente sin header_up explicito.
        }

        # --- API routers --------------------------------------------------------
        # SaaS primero: /api/saas/* es mas especifico que /api/* y debe ganar.
        #
        # Active health checks (#21): cada upstream declara por que path se lo
        # puede interrogar. `health_uri` NO es el path que se proxea: es el que
        # Caddy consulta directo al upstream, asi que aca son los mismos paths
        # que ya usan los healthchecks de docker-compose.
        #
        # Que compra: cuando un upstream deja de responder, Caddy lo saca de la
        # rotacion en `health_interval` segundos, en vez de esperar a que llegue
        # un request real y responderle un 502. Con un solo upstream por grupo
        # no hay rotacion que repartir: el sintoma cambia de "502 con el error
        # del upstream" a "503 no healthy upstream", que es el que corresponde
        # cuando el servicio esta caido.
        reverse_proxy /api/saas/* http://saas-api:8000 {
            header_up X-Forwarded-For {host}
            header_up X-Real-IP {remote}

            # El health del SaaS responde 200 mientras el proceso atienda; no
            # chequea Postgres ni Redis. Detecta el proceso colgado, que es lo
            # que este health check puede afirmar sin mentir.
            health_uri /api/saas/health
            health_interval 10s
            health_timeout 5s
            health_status 200
            # Con un upstream solo no cambia nada; queda explicito para cuando
            # haya mas de una replica del SaaS.
            lb_policy round_robin
        }

        # Backend Go/Fiber B2C (catalogo + checkout + MLM). Sin rewrite: el
        # Backend ya sirve bajo /api.
        reverse_proxy /api/* http://backend:3000 {
            header_up X-Forwarded-For {host}
            header_up X-Real-IP {remote}

            # El health del Backend pingea Postgres y Redis:
            #   - Postgres caido -> 503 (unhealthy): sin base no puede atender
            #     nada, asi que sale de rotacion.
            #   - Redis caido   -> 200 con status "degraded": el Backend sigue
            #     sirviendo sin cache, asi que `health_status 200` lo deja
            #     rutear a proposito.
            # El timeout del health es de 5s porque el ping del Backend puede
            # tardar hasta 2s por dependencia.
            health_uri /api/health
            health_interval 10s
            health_timeout 5s
            health_status 200
            lb_policy round_robin
        }

        # Frontend estatico. Ya no es placeholder: el `dist/` del SPA se compila
        # en el stage `frontend` de gateway/Dockerfile y la imagen final lo
        # copia a /srv/frontend, que es esta raiz. No hay volumen que montar.
        root * /srv/frontend

        # Fallback de SPA: si el path no existe en disco, se reescribe a
        # index.html. Sin esto, un refresh o un deep link de las rutas de
        # cliente (/catalogo, /mi-red, /producto/:id) devolveria 404 en vez de
        # la app. Los assets con hash (/assets/*.js) SI existen en disco, asi
        # que `try_files {path}` los sirve directos y no pasan por el fallback.
        # Debe quedar ANTES de file_server y dentro del `route` (ver arriba).
        try_files {path} /index.html

        file_server
    }

    # Logging estructurado (#21). Sin `format console`: el default de Caddy ya
    # es JSON, que es lo que necesita el agregador. `console` existe para leer
    # a ojo en desarrollo, pero rompe el parseo en produccion.
    log {
        output stdout
        level INFO
    }
}
