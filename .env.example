# Variables de entorno para el stack completo (root).
# Convencion: cualquier cosa sensible lleva prefijo segun el servicio
# (AUTH_, BACKEND_, SAAS_). Variables globales (APP_ENV, CORS_ORIGINS) sin prefijo.
#
# Para correr local: cp .env.example .env, ajustar y luego 'docker compose up'.

APP_ENV=dev
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# === Backend (Go/Fiber) ===
BACKEND_PORT=3000
BACKEND_DB_HOST=db
BACKEND_DB_PORT=5432
BACKEND_DB_USER=postgres
BACKEND_DB_PASSWORD=postgres
BACKEND_DB_NAME=multicatalogo
BACKEND_DB_SSLMODE=disable

# === auth-service (Go/Fiber) ===
AUTH_SERVICE_PORT=3001
AUTH_JWT_SECRET=replace-this-with-a-strong-random-value-in-production
AUTH_JWT_EXPIRES_SECONDS=7200
AUTH_DB_HOST=db
AUTH_DB_PORT=5432
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres
AUTH_DB_NAME=multicatalogo
AUTH_DB_SCHEMA=auth

# === SaaS (FastAPI) ===
SAAS_API_PORT=8000
SAAS_DB_HOST=db
SAAS_DB_PORT=5432
SAAS_DB_NAME=multicatalogo
SAAS_DB_SSLMODE=disable
# RUNTIME: credenciales con las que corre uvicorn. El rol tiene que ser SIN
# superuser: un superuser ignora las politicas RLS de la migracion 0003 y cada
# request veria las filas de todos los tenants. Lo crea la migracion
# 0004_saas_app_role.
SAAS_DB_USER=saas_app
SAAS_DB_PASSWORD=saas_app
# Nombre del rol de la app. Lo leen la migracion 0004 y los tests de
# integracion de RLS, para que no haya dos nombres distintos.
SAAS_DB_APP_ROLE=saas_app
# ADMIN: solo Alembic. Las migraciones hacen DDL (crean tablas, el rol de la app
# y las politicas), cosa que el rol de la app no puede ni debe hacer. El compose
# corre `alembic upgrade head` con estas credenciales y uvicorn con las de arriba.
SAAS_DB_ADMIN_USER=postgres
SAAS_DB_ADMIN_PASSWORD=postgres

# === Gateway (Caddy) ===
GATEWAY_PORT=8080

# === Postgres ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=multicatalogo
DB_PORT=5432

# === Redis (Backend lo usa para Cache-Aside) ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# === auth-service (consumido por Backend y SaaS) ===
# URL base con la que tanto Backend como SaaS hacen HTTP proxy.
AUTH_SERVICE_URL=http://auth-service:3001

# === Cloudflare Tunnel ===
# Token generado en Cloudflare Zero Trust -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

