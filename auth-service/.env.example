# Configuracion del auth-service.
# Convencion: prefijo AUTH_ para vars sensibles; resto sin prefijo.

APP_ENV=dev

# Secret para firmar los JWT. Si es igual a JWT_SECRET del Backend,
# los dos tipos de tokens se firman con la misma clave (compatible).
AUTH_JWT_SECRET=replace-this-with-a-strong-random-value-in-production
AUTH_JWT_EXPIRES_SECONDS=7200

# DB propia del auth-service (:5436, separada de BD Backend y SaaS).
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5436
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres
AUTH_DB_NAME=multicatalogo_auth

CORS_ORIGINS=http://localhost:5173
