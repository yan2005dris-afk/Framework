PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=multicatalogo
DB_SSLMODE=disable
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Seguridad (U2-T4)
# Generar uno fuerte en produccion: openssl rand -hex 48
JWT_SECRET=replace-this-secret-with-a-strong-random-value-in-production
APP_ENV=dev
JWT_EXPIRES_SECONDS=7200

# U3-T2 GA5: el Backend ahora hace HTTP-proxy a auth-service.
# Cuando se despliega con docker compose, el nombre DNS 'auth-service'
# resuelve al contenedor del auth-service.
AUTH_SERVICE_URL=http://auth-service:3001
