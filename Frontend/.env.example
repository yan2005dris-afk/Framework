# Variables de entorno para el frontend Vite.
# Convencion: este archivo es la fuente de verdad del contrato.
# Para desarrollo local: copiarlo a `.env` (NO versionado, ignorado por .gitignore).
#   cp Frontend/.env.example Frontend/.env
# Para deploy: sobreescribir en runtime o usar .env.production.

# URL base del backend Go/Fiber.
# - Desarrollo local: http://localhost:8080/api
# - Staging/Prod detras de Caddy/Nginx (U4): apuntar al proxy reverso
#   que enrute /api/tx/* y /api/saas/* a los servicios correspondientes.
VITE_API_URL=http://localhost:8080/api
