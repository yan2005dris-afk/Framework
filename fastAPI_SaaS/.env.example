# Configuracion del SaaS.
# Convencion: prefijo SAAS_ para vars sensibles; resto sin prefijo.

APP_ENV=dev

# URL base del auth-service al que el SaaS proxy-eea los endpoints de auth.
# En docker-compose es http://auth-service:3001 (resoluble via DNS Docker).
# En dev nativo, http://localhost:3001.
AUTH_SERVICE_URL=http://auth-service:3001

CORS_ORIGINS=http://localhost:5173

# --- BD: dos identidades ---
# ADMIN: solo Alembic. Las migraciones hacen DDL (crean tablas, el rol de la app
# y las politicas RLS), asi que necesitan superuser en este compose.
SAAS_DB_ADMIN_USER=postgres
SAAS_DB_ADMIN_PASSWORD=postgres

# Rol de la APP: sin superuser, porque un superuser ignora las politicas RLS de
# la migracion 0003. Lo crea la migracion 0004_saas_app_role con el password de
# runtime (`SAAS_DB_PASSWORD`), asi que el servicio conecta con el default de
# `app/core/config.py`: usuario saas_app.
SAAS_DB_APP_ROLE=saas_app

# OJO: en este directorio NO pongas SAAS_DB_USER/SAAS_DB_PASSWORD. El
# docker-compose local los usa como POSTGRES_USER/POSTGRES_PASSWORD del
# superuser de `saas-db`; si definieras ahi el rol de la app, el superuser del
# contenedor seria ese rol y la migracion 0004 le bajaria los privilegios.
# Para el stack del repo (compose de la raiz) si se definen: ahi el superuser
# es POSTGRES_USER y el SaaS corre con saas_app.
