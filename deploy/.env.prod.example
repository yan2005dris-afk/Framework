# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - PRODUCCIÓN (deploy/.env)
# ==============================================================================
# Copiar este archivo a deploy/.env en el servidor Proxmox:
#   cp deploy/.env.prod.example deploy/.env
# ==============================================================================

# === CONFIGURACIÓN GLOBAL ===
APP_ENV=prod
CORS_ORIGINS=https://framework.yandro.tech,http://localhost:8080

# === DOCKER REGISTRY & RELEASES ===
GHCR_OWNER=yan2005dris-afk
IMAGE_TAG=latest

# === BASE DE DATOS (PostgreSQL 16) ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=multicatalogo
DB_PORT=5432

# === CACHÉ & SESIONES (Redis) ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# === SERVICIO DE AUTENTICACIÓN (Go/Fiber auth-service) ===
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_URL=http://auth-service:3001
AUTH_JWT_SECRET=f93bbb0b9469cb294e4edc71384a7eeb79e1fc7f0a6636b1cd24f49fda149ae1
AUTH_JWT_EXPIRES_SECONDS=7200
AUTH_DB_HOST=db
AUTH_DB_PORT=5432
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=${POSTGRES_PASSWORD}
AUTH_DB_NAME=multicatalogo
AUTH_DB_SCHEMA=auth

# === BACKEND PRINCIPAL B2C (Go/Fiber) ===
BACKEND_PORT=3000
BACKEND_DB_HOST=db
BACKEND_DB_PORT=5432
BACKEND_DB_USER=postgres
BACKEND_DB_PASSWORD=${POSTGRES_PASSWORD}
BACKEND_DB_NAME=multicatalogo
BACKEND_DB_SSLMODE=disable

# === PLATAFORMA SAAS (FastAPI Multi-Tenant) ===
SAAS_API_PORT=8000
SAAS_DB_HOST=db
SAAS_DB_PORT=5432
SAAS_DB_NAME=multicatalogo
SAAS_DB_SSLMODE=disable
# Rol de aplicación con RLS activo (sin superuser)
SAAS_DB_USER=saas_app
SAAS_DB_PASSWORD=saas_app
SAAS_DB_APP_ROLE=saas_app
# Rol administrativo para migraciones DDL con Alembic
SAAS_DB_ADMIN_USER=postgres
SAAS_DB_ADMIN_PASSWORD=${POSTGRES_PASSWORD}

# === API GATEWAY (Caddy + SPA Frontend) ===
GATEWAY_PORT=8080
HTTP_PORT=80
TLS_PORT=443
# SITE_ADDRESS=framework.yandro.tech
# ACME_EMAIL=admin@yandro.tech

# === CLOUDFLARE ZERO TRUST TUNNEL ===
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiODJlN2EyZWE0OTQyOTlmZDgwOWJkNjIxOGRiYzA3MzEiLCJ0IjoiZjEyY2U2ZTctNjdhOC00ZTNiLTgxMDMtNjVhNWQzMDJlNzIxIiwicyI6Ik0ySmlZamxoWTJFdE9XRXhOaTAwWkRZekxUZ3paalV0WmpKalpUQmxORFJsTXpneSJ9

# === WATCHTOWER (Despliegue Continuo Automático) ===
DOCKER_API_VERSION=1.44
WATCHTOWER_POLL_INTERVAL=300
WATCHTOWER_CLEANUP=true
