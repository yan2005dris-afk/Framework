# Variables de entorno para Producción (VM 104 Proxmox).
# Copiar este archivo a deploy/.env y definir secretos reales:
# cp deploy/.env.prod.example deploy/.env

APP_ENV=prod
CORS_ORIGINS=http://localhost:8080

# === Registry & Tags ===
GHCR_OWNER=yan2005dris-afk
IMAGE_TAG=latest

# === Postgres ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here
POSTGRES_DB=multicatalogo
DB_PORT=5432

# === Redis ===
REDIS_PORT=6379
REDIS_PASSWORD=

# === auth-service (Go/Fiber) ===
AUTH_SERVICE_PORT=3001
AUTH_JWT_SECRET=generate_a_64_character_hex_or_random_secret_for_production
AUTH_JWT_EXPIRES_SECONDS=7200
AUTH_DB_HOST=db
AUTH_DB_PORT=5432
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=${POSTGRES_PASSWORD}
AUTH_DB_NAME=multicatalogo
AUTH_DB_SCHEMA=auth
AUTH_SERVICE_URL=http://auth-service:3001

# === Backend (Go/Fiber) ===
BACKEND_PORT=3000
BACKEND_DB_HOST=db
BACKEND_DB_PORT=5432
BACKEND_DB_USER=postgres
BACKEND_DB_PASSWORD=${POSTGRES_PASSWORD}
BACKEND_DB_NAME=multicatalogo
BACKEND_DB_SSLMODE=disable
REDIS_HOST=redis

# === SaaS (FastAPI) ===
SAAS_API_PORT=8000
SAAS_DB_HOST=db
SAAS_DB_PORT=5432
SAAS_DB_NAME=multicatalogo
SAAS_DB_SSLMODE=disable
SAAS_DB_USER=saas_app
SAAS_DB_PASSWORD=generate_saas_app_password_here
SAAS_DB_APP_ROLE=saas_app
SAAS_DB_ADMIN_USER=postgres
SAAS_DB_ADMIN_PASSWORD=${POSTGRES_PASSWORD}

# === Gateway (Caddy) ===
GATEWAY_PORT=8080
# Para exponer con dominio público y certificados TLS automáticos de Let's Encrypt:
# SITE_ADDRESS=framework.tudominio.com
# ACME_EMAIL=admin@tudominio.com
# HTTP_PORT=80
# TLS_PORT=443

# === Cloudflare Tunnel (Opcional si se usa Zero Trust en lugar de Caddy TLS directo) ===
CLOUDFLARE_TUNNEL_TOKEN=

# === Watchtower ===
WATCHTOWER_POLL_INTERVAL=300
WATCHTOWER_CLEANUP=true
